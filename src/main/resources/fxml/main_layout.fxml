<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.psychemap.ui.controller.MainLayoutController"
            prefWidth="1200" prefHeight="720">

        <left>
        <VBox styleClass="sidebar" prefWidth="250" minWidth="250" spacing="6">
            <Label text="PsycheMap" styleClass="logo-texto">
                <VBox.margin>
                    <Insets left="8" bottom="16"/>
                </VBox.margin>
            </Label>

                        <Button fx:id="btnAtlas" text="Atlas nosológico" styleClass="nav-boton"
                    maxWidth="Infinity" onAction="#onAtlas"/>
            <Button fx:id="btnUsuarios" text="Gestión de usuarios" styleClass="nav-boton"
                    maxWidth="Infinity" onAction="#onUsuarios"/>
            <Button fx:id="btnBitacora" text="Bitácora de auditoría" styleClass="nav-boton"
                    maxWidth="Infinity" onAction="#onBitacora"/>

                        <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="lblNotaRol" styleClass="nota-rol" wrapText="true" maxWidth="Infinity"/>
            <Button text="Cerrar sesión" styleClass="boton-peligro" maxWidth="Infinity"
                    onAction="#onCerrarSesion">
                <VBox.margin>
                    <Insets top="8"/>
                </VBox.margin>
            </Button>
        </VBox>
    </left>

        <center>
        <BorderPane>
            <top>
                <HBox styleClass="encabezado" alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="2">
                        <Label fx:id="lblTitulo" styleClass="titulo-pagina"/>
                        <Label fx:id="lblSubtitulo" styleClass="texto-gris"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="lblNombre" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblRol" styleClass="texto-gris"/>
                    </VBox>
                    <Label fx:id="lblAvatar" styleClass="avatar"/>
                </HBox>
            </top>

                        <center>
                <StackPane fx:id="contenido">
                    <padding>
                        <Insets top="0" right="28" bottom="28" left="28"/>
                    </padding>
                </StackPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>

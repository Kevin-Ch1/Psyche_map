<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.psychemap.ui.controller.AtlasViewController" spacing="18">

        <VBox styleClass="card" prefWidth="520" minWidth="420">
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>

                                <Tab text="Buscar trastorno">
                    <VBox spacing="12">
                        <padding>
                            <Insets top="14"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Trastornos" styleClass="titulo-seccion"/>
                            <Label fx:id="lblConteo"/>
                        </HBox>
                        <TextField fx:id="tfBuscar" promptText="Buscar por código o nombre"/>
                        <TableView fx:id="tablaTrastornos" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colCodigo" text="CÓDIGO" prefWidth="90" minWidth="90"/>
                                <TableColumn fx:id="colNombre" text="TRASTORNO" prefWidth="270"/>
                                <TableColumn fx:id="colCategoria" text="CATEGORÍA" prefWidth="130"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>

                                <Tab text="Por síntomas">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="14"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="tfFiltroSintomas" promptText="Filtrar síntomas…" HBox.hgrow="ALWAYS"/>
                            <Button text="Limpiar" styleClass="boton-suave" onAction="#onLimpiarSintomas"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="SIGNOS Y SÍNTOMAS" styleClass="campo-label"/>
                            <Label fx:id="lblMarcados"/>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="200" minHeight="120">
                            <VBox fx:id="vbSintomasLista" spacing="4"/>
                        </ScrollPane>

                        <Label text="COMPATIBILIDAD" styleClass="campo-label"/>
                        <TableView fx:id="tablaCompat" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colCompCodigo" text="CÓDIGO" prefWidth="90" minWidth="90"/>
                                <TableColumn fx:id="colCompNombre" text="TRASTORNO" prefWidth="200"/>
                                <TableColumn fx:id="colCompPct" text="COMPATIBILIDAD" prefWidth="170"/>
                            </columns>
                        </TableView>
                        <Label text="Apoyo al juicio clínico; no constituye diagnóstico." styleClass="texto-gris"/>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>

        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10">
                <Label fx:id="lblVacio" styleClass="texto-gris" wrapText="true"
               text="Selecciona un trastorno (buscándolo o desde la compatibilidad por síntomas) para leer sus criterios y síntomas."/>

                <ScrollPane fx:id="spDetalle" fitToWidth="true" hbarPolicy="NEVER"
                    visible="false" managed="false" VBox.vgrow="ALWAYS">
            <VBox spacing="10">
                <padding>
                    <Insets right="12"/>
                </padding>

                <Label fx:id="lblCodigo" styleClass="codigo-grande"/>
                <Label fx:id="lblNombre" styleClass="nombre-trastorno" wrapText="true"/>
                <Label fx:id="lblInfo" styleClass="texto-gris" wrapText="true"/>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                    <Label text="CRITERIOS DIAGNÓSTICOS" styleClass="campo-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="btnAgregarCriterio" text="＋ Agregar criterio" styleClass="boton-morado"
                            onAction="#onAgregarCriterio"/>
                </HBox>
                <VBox fx:id="vbCriterios" spacing="8"/>

                <Label text="SÍNTOMAS DEL TRASTORNO" styleClass="campo-label">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>
                <VBox fx:id="vbSintomas" spacing="8"/>

                <Label text="Apoyo al juicio clínico; no constituye diagnóstico." styleClass="texto-gris">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
